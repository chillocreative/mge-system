{
    "name": "chillocreative/qwen-agent",
    "description": "Reusable Qwen coding sub-agent service + Artisan command for Laravel projects (Claude-as-lead delegation pattern)",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Chillocreative\\QwenAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chillocreative\\QwenAgent\\QwenAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
